index 0000000..bad5911
--- /dev/null
+++ b/tests/test_result_helpers.py
@@ -0,0 +1,33 @@
+import pytest
+
+import click
+
+
+@click.command()
+@click.option("--code", default=0)
+def cli(code):
+    click.echo("one")
+    click.echo("two")
+    raise click.exceptions.Exit(code)
+
+
+def test_output_lines(runner):
+    assert runner.invoke(cli).output_lines == ["one", "two"]
+
+
+def test_assert_success(runner):
+    result = runner.invoke(cli)
+    assert result.assert_success() is result
+    assert result.assert_success(output="one\ntwo\n") is result
+
+    with pytest.raises(AssertionError, match="Expected output"):
+        result.assert_success(output="one\ntwo")
+
+
+def test_assert_success_exit_code(runner):
+    result = runner.invoke(cli, ["--code", "3"])
+
+    with pytest.raises(AssertionError, match="got 3") as exc_info:
+        result.assert_success(output="one\ntwo\n")
+
+    assert "one\ntwo\n" in str(exc_info.value)

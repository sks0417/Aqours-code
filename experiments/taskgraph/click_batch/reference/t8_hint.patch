diff --git a/tests/test_error_hints.py b/tests/test_error_hints.py
new file mode 100644
index 0000000..26613a0
--- /dev/null
+++ b/tests/test_error_hints.py
@@ -0,0 +1,51 @@
+import io
+
+import pytest
+
+import click
+
+
+def show(exc):
+    out = io.StringIO()
+    exc.show(out)
+    return out.getvalue()
+
+
+@pytest.mark.parametrize(
+    ("exc", "expect"),
+    [
+        (click.ClickException("boom", hint="retry"), "Error: boom\nHint: retry\n"),
+        (click.ClickException("boom"), "Error: boom\n"),
+        (click.UsageError("bad", hint="retry"), "Error: bad\nHint: retry\n"),
+        (
+            click.BadParameter("bad", param_hint="--x", hint="retry"),
+            "Error: Invalid value for --x: bad\nHint: retry\n",
+        ),
+        (
+            click.NoSuchOption("--x", hint="retry"),
+            "Error: No such option '--x'.\nHint: retry\n",
+        ),
+        (
+            click.FileError("f.txt", hint="denied"),
+            "Error: Could not open file 'f.txt': denied\n",
+        ),
+    ],
+)
+def test_show(exc, expect):
+    assert show(exc) == expect
+
+
+def test_hint_attribute():
+    assert click.UsageError("bad", hint="retry").hint == "retry"
+    assert click.UsageError("bad").hint is None
+    assert click.FileError("f.txt", hint="denied").hint is None
+
+
+def test_command_output(runner):
+    @click.command()
+    def cli():
+        raise click.UsageError("bad", hint="retry")
+
+    result = runner.invoke(cli)
+    assert result.exit_code == 2
+    assert result.output.endswith("\n\nError: bad\nHint: retry\n")

diff --git a/tests/test_wrap_bullets.py b/tests/test_wrap_bullets.py
new file mode 100644
index 0000000..6bdf17a
--- /dev/null
+++ b/tests/test_wrap_bullets.py
@@ -0,0 +1,41 @@
+import pytest
+
+from click import wrap_text
+
+TEXT = "Some words before the list.\n- alpha beta gamma delta\n  epsilon\n10. zeta eta theta iota"
+
+
+def test_default_unchanged():
+    assert wrap_text(TEXT, 20, preserve_bullets=False) == wrap_text(TEXT, 20)
+    assert wrap_text("a b c", 3, preserve_bullets=True) == wrap_text("a b c", 3)
+
+
+@pytest.mark.parametrize("marker", ["- ", "* ", "1. ", "12. "])
+def test_item_indent(marker):
+    indent = " " * len(marker)
+    text = f"{marker}alpha beta gamma delta\n{marker}epsilon"
+    assert wrap_text(text, len(marker) + 16, preserve_bullets=True) == (
+        f"{marker}alpha beta gamma\n{indent}delta\n{marker}epsilon"
+    )
+
+
+def test_text_and_items():
+    assert wrap_text(TEXT, 20, preserve_bullets=True) == (
+        "Some words before\nthe list.\n"
+        "- alpha beta gamma\n  delta epsilon\n"
+        "10. zeta eta theta\n    iota"
+    )
+
+
+def test_paragraphs_and_indents():
+    text = f"  {TEXT}\n\nLast words."
+    wrapped = wrap_text(
+        text, 24, initial_indent="> ", subsequent_indent="| ",
+        preserve_paragraphs=True, preserve_bullets=True,
+    )
+    assert wrapped == (
+        ">   Some words before\n|   the list.\n"
+        "|   - alpha beta gamma\n|     delta epsilon\n"
+        "|   10. zeta eta theta\n|       iota\n\n"
+        "> Last words."
+    )

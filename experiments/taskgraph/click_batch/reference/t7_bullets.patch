+_BULLET_RE = re.compile(r"(?:[-*]|\d+\.) ")
+
+
+def _fill_bullets(wrapper: TextWrapper, text: str, joiner: str) -> str:
+    """Wrap ``text`` like ``wrapper.fill``, but wrap every bullet item
+    on its own, with its continuation lines aligned after the marker.
+
+    :param joiner: Joins the lines of text that is not a bullet item,
+        as the caller did before wrapping it.
+    """
+    # (marker, lines); the marker is empty for text that is not an item.
+    blocks: list[tuple[str, list[str]]] = []
+
+    for line in text.splitlines():
+        stripped = line.lstrip()
+        match = _BULLET_RE.match(stripped)
+
+        if match is not None:
+            blocks.append((match.group(), [stripped[match.end() :]]))
+        elif blocks and (stripped or not blocks[-1][0]):
+            blocks[-1][1].append(line)
+        else:
+            # The first line, or an empty line that ends a bullet item.
+            blocks.append(("", [line]))
+
+    if not blocks:
+        return wrapper.fill(text)
+
+    initial_indent = wrapper.initial_indent
+    subsequent_indent = wrapper.subsequent_indent
+    rv = []
+
+    try:
+        for marker, lines in blocks:
+            if marker:
+                wrapper.initial_indent += marker
+                wrapper.subsequent_indent += " " * len(marker)
+                rv.append(wrapper.fill(" ".join(line.strip() for line in lines)))
+            else:
+                rv.append(wrapper.fill(joiner.join(lines)))
+
+            # Only the first line of the whole text gets the initial indent.
+            wrapper.initial_indent = wrapper.subsequent_indent = subsequent_indent
+    finally:
+        wrapper.initial_indent = initial_indent
+        wrapper.subsequent_indent = subsequent_indent
+
+    return "\n".join(rv)
+

@@ -0,0 +1,41 @@
+import pytest
+
+import click
+
+
+def run(runner, input, default=None):
+    @click.command()
+    def cli():
+        click.echo(click.select("Colour?", ["red", "green", "blue"], default=default))
+
+    return runner.invoke(cli, input=input)
+
+
+@pytest.mark.parametrize(("input", "expect"), [("1\n", "red"), ("blue\n", "blue")])
+def test_select(runner, input, expect):
+    result = run(runner, input)
+    assert result.output == (
+        "Colour?\n  1) red\n  2) green\n  3) blue\n"
+        f"Enter a number: {input}{expect}\n"
+    )
+
+
+def test_default(runner):
+    result = run(runner, "\n", default="green")
+    assert "Enter a number [2]: " in result.output
+    assert result.output.endswith("\ngreen\n")
+
+
+def test_invalid_answer_prompts_again(runner):
+    result = run(runner, "4\npink\n3\n")
+    assert "Error: '4' is not a valid choice.\n" in result.output
+    assert "Error: 'pink' is not a valid choice.\n" in result.output
+    assert result.output.endswith("\nblue\n")
+
+
+def test_invalid_arguments():
+    with pytest.raises(ValueError):
+        click.select("Colour?", [])
+
+    with pytest.raises(ValueError):
+        click.select("Colour?", ["red"], default="blue")

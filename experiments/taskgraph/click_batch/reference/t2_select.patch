+def select(text: str, options: cabc.Sequence[str], default: str | None = None) -> str:
+    """Let the user pick one of several strings and return it.
+
+    Prints ``text`` and a numbered list of the options, then prompts for
+    a number. The answer may also be the exact text of an option. Any
+    other answer shows an error and prompts again.
+
+    :param text: The text to show above the options.
+    :param options: The strings to choose from.
+    :param default: The option used when no input is given.
+    :raises ValueError: If ``options`` is empty or ``default`` is not one
+        of the options.
+
+    .. versionadded:: 8.6.0
+    """
+    options = list(options)
+
+    if not options:
+        raise ValueError("'options' must not be empty.")
+
+    if default is not None and default not in options:
+        raise ValueError(f"The default {default!r} is not one of the options.")
+
+    def value_proc(answer: str) -> str:
+        if answer in options:
+            return answer
+
+        if answer.isascii() and answer.isdigit() and 1 <= int(answer) <= len(options):
+            return options[int(answer) - 1]
+
+        raise UsageError(_("{answer!r} is not a valid choice.").format(answer=answer))
+
+    echo(text)
+
+    for number, option in enumerate(options, 1):
+        echo(f"  {number}) {option}")
+
+    return prompt(
+        _("Enter a number"),
+        default=None if default is None else str(options.index(default) + 1),
+        value_proc=value_proc,
+    )
+
+

@@ -0,0 +1,29 @@
+import pytest
+
+import click
+
+
+@pytest.mark.parametrize(
+    ("num_bytes", "binary", "expect"),
+    [
+        (0, False, "0 B"),
+        (999, False, "999 B"),
+        (1000, False, "1.0 kB"),
+        (1500, False, "1.5 kB"),
+        (2_500_000, False, "2.5 MB"),
+        (10**15, False, "1.0 PB"),
+        (10**19, False, "10000.0 PB"),
+        (1023, True, "1023 B"),
+        (1024, True, "1.0 KiB"),
+        (2 * 1024**2, True, "2.0 MiB"),
+        (3 * 1024**3, True, "3.0 GiB"),
+        (1024**6, True, "1024.0 PiB"),
+    ],
+)
+def test_format_size(num_bytes, binary, expect):
+    assert click.format_size(num_bytes, binary=binary) == expect
+
+
+def test_negative():
+    with pytest.raises(ValueError):
+        click.format_size(-1)

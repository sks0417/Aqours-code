+def format_size(num_bytes: int, binary: bool = False) -> str:
+    """Format a number of bytes as a human-readable size, such as
+    ``"1.5 kB"``.
+
+    Values below one kilobyte are shown as an integer number of bytes.
+    Larger values use the largest unit that keeps the number at least 1,
+    with one decimal.
+
+    :param num_bytes: The size in bytes. Must not be negative.
+    :param binary: Use powers of 1024 and the units ``KiB``, ``MiB``, ...
+        instead of powers of 1000 and ``kB``, ``MB``, ...
+
+    .. versionadded:: 8.6.0
+    """
+    if num_bytes < 0:
+        raise ValueError("'num_bytes' must not be negative.")
+
+    if binary:
+        base, units = 1024, ("KiB", "MiB", "GiB", "TiB", "PiB")
+    else:
+        base, units = 1000, ("kB", "MB", "GB", "TB", "PB")
+
+    if num_bytes < base:
+        return f"{int(num_bytes)} B"
+
+    size = num_bytes / base
+    unit = 0
+
+    while size >= base and unit < len(units) - 1:
+        size /= base
+        unit += 1
+
+    return f"{size:.1f} {units[unit]}"
+

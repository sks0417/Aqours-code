+class DurationInfoDict(ParamTypeInfoDict):
+    min: float | None
+    max: float | None
+
+
+_DURATION_NUMBER = r"\d+(?:\.\d+)?"
+# Each group is named after the ``timedelta`` argument it fills.
+_DURATION_RE = re.compile(
+    "".join(
+        rf"(?:(?P<{unit}>{_DURATION_NUMBER}){unit[0]})?"
+        for unit in ("days", "hours", "minutes", "seconds")
+    )
+)
+
+
+class Duration(ParamType[timedelta]):
+    """The Duration type converts a duration into a
+    :class:`datetime.timedelta`.
+
+    A plain non-negative number is a number of seconds (``"90"``,
+    ``"1.5"``). Otherwise the value is one or more ``<number><unit>``
+    parts with the units ``d``, ``h``, ``m``, ``s``, in this order and
+    each at most once, without spaces (``"1h30m"``, ``"1.5h"``).
+
+    :param min: The smallest accepted duration (inclusive).
+    :param max: The largest accepted duration (inclusive).
+
+    .. versionadded:: 8.6.0
+    """
+
+    name = "duration"
+
+    min: timedelta | None
+    max: timedelta | None
+
+    def __init__(
+        self, min: timedelta | None = None, max: timedelta | None = None
+    ) -> None:
+        self.min = min
+        self.max = max
+
+    def to_info_dict(self) -> DurationInfoDict:
+        return {
+            **super().to_info_dict(),
+            "min": None if self.min is None else self.min.total_seconds(),
+            "max": None if self.max is None else self.max.total_seconds(),
+        }
+
+    def _parse(self, value: t.Any) -> timedelta | None:
+        if not isinstance(value, str) or not value:
+            return None
+
+        if re.fullmatch(_DURATION_NUMBER, value):
+            return timedelta(seconds=float(value))
+
+        match = _DURATION_RE.fullmatch(value)
+
+        if match is None:
+            return None
+
+        return timedelta(
+            **{
+                unit: float(number)
+                for unit, number in match.groupdict().items()
+                if number is not None
+            }
+        )
+
+    def convert(
+        self, value: t.Any, param: Parameter | None, ctx: Context | None
+    ) -> timedelta:
+        if isinstance(value, timedelta):
+            return value
+
+        try:
+            converted = self._parse(value)
+        except OverflowError:
+            converted = None
+
+        if converted is None:
+            self.fail(
+                _("{value!r} is not a valid duration.").format(value=value),
+                param,
+                ctx,
+            )
+
+        if (self.min is not None and converted < self.min) or (
+            self.max is not None and converted > self.max
+        ):
+            self.fail(
+                _("{value!r} is out of range.").format(value=value), param, ctx
+            )
+
+        return converted
+
+    def __repr__(self) -> str:
+        return f"Duration({self.min!r}, {self.max!r})"
+
+
 class _NumberParamTypeBase(
     ParamType[_ValueT_co], t.Generic[_ValueT_contra, _ValueT_co]
 ):

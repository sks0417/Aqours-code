--- /dev/null
+++ b/tests/test_duration.py
@@ -0,0 +1,58 @@
+from datetime import timedelta
+
+import pytest
+
+import click
+
+
+@pytest.mark.parametrize(
+    ("value", "expect"),
+    [
+        ("90", timedelta(seconds=90)),
+        ("1.5", timedelta(seconds=1.5)),
+        ("45s", timedelta(seconds=45)),
+        ("1h30m", timedelta(hours=1, minutes=30)),
+        ("1d2h3m4s", timedelta(days=1, hours=2, minutes=3, seconds=4)),
+        ("1.5h", timedelta(minutes=90)),
+        (timedelta(days=2), timedelta(days=2)),
+    ],
+)
+def test_convert(value, expect):
+    assert click.Duration().convert(value, None, None) == expect
+
+
+@pytest.mark.parametrize("value", ["", "abc", "1m1h", "1h1h", "1 h", "1H", "-5", "1x"])
+def test_invalid(runner, value):
+    @click.command()
+    @click.option("--timeout", type=click.Duration())
+    def cli(timeout):
+        pass
+
+    result = runner.invoke(cli, [f"--timeout={value}"])
+    assert result.exit_code == 2
+    assert f"{value!r} is not a valid duration." in result.output
+
+
+def test_bounds():
+    duration = click.Duration(min=timedelta(minutes=1), max=timedelta(hours=1))
+    assert duration.convert("1m", None, None) == timedelta(minutes=1)
+    assert duration.convert("1h", None, None) == timedelta(hours=1)
+
+    for value in "59s", "61m":
+        with pytest.raises(click.BadParameter, match="is out of range"):
+            duration.convert(value, None, None)
+
+
+def test_metavar_and_info_dict(runner):
+    @click.command()
+    @click.option("--timeout", type=click.Duration(max=timedelta(minutes=1)))
+    def cli(timeout):
+        pass
+
+    assert "--timeout DURATION" in runner.invoke(cli, ["--help"]).output
+    assert click.Duration(max=timedelta(minutes=1)).to_info_dict() == {
+        "param_type": "Duration",
+        "name": "duration",
+        "min": None,
+        "max": 60.0,
+    }

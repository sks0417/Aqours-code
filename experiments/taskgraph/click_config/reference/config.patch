+        if ctx.resilient_parsing:
+            return
+
+        path = value
+
+        if path is None:
+            for default_path in default_paths:
+                candidate = os.path.expanduser(os.fspath(default_path))
+
+                if os.path.isfile(candidate):
+                    path = candidate
+                    break
+            else:
+                return
+
+        ctx.config = load_config(path)
+        ctx.config_path = path
+

+class ConfigError(ClickException):
+    """Raised if a configuration file cannot be read or written, or if a
+    command's configuration has keys that none of its parameters use.
+
+    :param message: The error message.
+    :param path: The configuration file the error is about, if any.
+
+    .. versionadded:: 8.6
+    """
+
+    exit_code: t.ClassVar[int] = 2
+
+    path: str | None
+
+    def __init__(self, message: str, path: str | None = None) -> None:
+        super().__init__(message)
+        self.path = path
+
+    def format_message(self) -> str:
+        if self.path is not None:
+            return f"{self.path}: {self.message}"
+
+        return self.message

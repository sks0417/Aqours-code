+"""Reading and writing configuration files.
+
+A configuration file holds parameter values for a command line program, in
+TOML or JSON, chosen by the file suffix. :func:`load_config` reads one into a
+``dict`` that can be passed as :attr:`Context.config`, and
+:func:`dump_config` writes one.
+
+.. versionadded:: 8.6
+"""
+
+from __future__ import annotations
+
+import collections.abc as cabc
+import os
+import re
+import sys
+import typing as t
+from gettext import gettext as _
+
+from .exceptions import ConfigError
+
+_BARE_KEY = re.compile(r"[A-Za-z0-9_-]+")
+_ESCAPES = {
+    "\\": "\\\\",
+    '"': '\\"',
+    "\b": "\\b",
+    "\t": "\\t",
+    "\n": "\\n",
+    "\f": "\\f",
+    "\r": "\\r",
+}
+
+
+def _config_format(path: str | os.PathLike[str]) -> str:
+    """Return ``"toml"`` or ``"json"`` for the suffix of ``path``.
+
+    :raise ConfigError: The suffix is neither ``.toml`` nor ``.json``.
+    """
+    suffix = os.path.splitext(os.fspath(path))[1].lower()
+
+    if suffix not in (".toml", ".json"):
+        raise ConfigError(
+            _(
+                "unsupported configuration file type {suffix!r}, expected"
+                " '.toml' or '.json'"
+            ).format(suffix=suffix),
+            path=str(path),
+        )
+
+    return suffix[1:]
+
+
+def _normalize_keys(value: t.Any) -> t.Any:
+    """Replace ``-`` by ``_`` in every key of ``value``, at every level."""
+    if isinstance(value, dict):
+        return {
+            key.replace("-", "_"): _normalize_keys(item) for key, item in value.items()
+        }
+
+    if isinstance(value, list):
+        return [_normalize_keys(item) for item in value]
+
+    return value
+
+
+def load_config(path: str | os.PathLike[str]) -> dict[str, t.Any]:
+    """Read a configuration file and return its content as a ``dict``.
+
+    The format follows the file suffix, ignoring case: ``.toml`` is read with
+    :mod:`tomllib`, ``.json`` with :mod:`json`. The file is read as UTF-8. In
+    every key, at every level of nesting, ``-`` is replaced by ``_``. Values
+    are not changed.
+
+    :param path: The file to read.
+    :raise ConfigError: The suffix is not supported, the file cannot be
+        read, or its content is not valid. :attr:`ConfigError.path` is
+        ``str(path)``.
+
+    .. versionadded:: 8.6
+    """
+    name = str(path)
+    kind = _config_format(path)
+
+    if kind == "toml" and sys.version_info < (3, 11):
+        raise ConfigError(_("reading TOML files requires Python 3.11 or later"), name)
+
+    try:
+        with open(path, encoding="utf-8") as f:
+            text = f.read()
+    except (OSError, UnicodeError) as e:
+        reason = e.strerror if isinstance(e, OSError) and e.strerror else str(e)
+        raise ConfigError(
+            _("cannot read the file: {reason}").format(reason=reason), name
+        ) from e
+
+    data: t.Any
+
+    if kind == "toml":
+        import tomllib
+
+        try:
+            data = tomllib.loads(text)
+        except tomllib.TOMLDecodeError as e:
+            raise ConfigError(_("invalid TOML: {error}").format(error=e), name) from e
+    else:
+        import json
+
+        try:
+            data = json.loads(text)
+        except ValueError as e:
+            raise ConfigError(_("invalid JSON: {error}").format(error=e), name) from e
+
+        if not isinstance(data, dict):
+            raise ConfigError(
+                _("a JSON configuration file must contain a table (an object)"),
+                name,
+            )
+
+    return t.cast("dict[str, t.Any]", _normalize_keys(data))
+
+
+def _writable(value: t.Any, key: str, in_list: bool = False) -> t.Any:
+    """Return ``value`` without the keys whose value is ``None``.
+
+    :raise ConfigError: ``value`` holds something that cannot be written.
+    """
+    if isinstance(value, (str, int, float)):
+        return value
+
+    if isinstance(value, list):
+        return [_writable(item, key, in_list=True) for item in value]
+
+    if isinstance(value, cabc.Mapping) and not in_list:
+        result = {}
+
+        for name, item in value.items():
+            if not isinstance(name, str):
+                raise ConfigError(
+                    _("cannot write key {name!r} of type {type}").format(
+                        name=name, type=type(name).__name__
+                    )
+                )
+
+            if item is not None:
+                result[name] = _writable(item, f"{key}.{name}" if key else name)
+
+        return result
+
+    raise ConfigError(
+        _("cannot write {key!r}: values of type {type} are not supported").format(
+            key=key, type=type(value).__name__
+        )
+    )
+
+
+def _toml_string(value: str) -> str:
+    """Write ``value`` as a TOML basic string."""
+    parts = []
+
+    for char in value:
+        if char in _ESCAPES:
+            parts.append(_ESCAPES[char])
+        elif char < " " or char == "\x7f":
+            parts.append(f"\\u{ord(char):04X}")
+        else:
+            parts.append(char)
+
+    return f'"{"".join(parts)}"'
+
+
+def _toml_key(key: str) -> str:
+    """Write ``key`` bare if TOML allows it, as a quoted string otherwise."""
+    if _BARE_KEY.fullmatch(key):
+        return key
+
+    return _toml_string(key)
+
+
+def _toml_value(value: t.Any) -> str:
+    """Write a value that is not a mapping."""
+    if isinstance(value, bool):
+        return "true" if value else "false"
+
+    if isinstance(value, int):
+        return int.__repr__(value)
+
+    if isinstance(value, float):
+        return float.__repr__(value)
+
+    if isinstance(value, str):
+        return _toml_string(value)
+
+    return f"[{', '.join(_toml_value(item) for item in value)}]"
+
+
+def _toml_table(table: cabc.Mapping[str, t.Any], header: list[str]) -> list[str]:
+    """Write the lines of ``table``, then its nested tables."""
+    lines = []
+
+    if header:
+        lines.extend(["", f"[{'.'.join(_toml_key(part) for part in header)}]"])
+
+    for key, value in table.items():
+        if not isinstance(value, cabc.Mapping):
+            lines.append(f"{_toml_key(key)} = {_toml_value(value)}")
+
+    for key, value in table.items():
+        if isinstance(value, cabc.Mapping):
+            lines.extend(_toml_table(value, [*header, key]))
+
+    return lines
+
+
+def dump_config(data: cabc.Mapping[str, t.Any], path: str | os.PathLike[str]) -> None:
+    """Write the mapping ``data`` to a configuration file.
+
+    The format follows the file suffix as for :func:`load_config`. Values
+    may be ``str``, ``int``, ``float``, ``bool``, lists of such values, and
+    mappings with ``str`` keys. A key whose value is ``None`` is left out.
+    The file is written as UTF-8. JSON is written with an indent of 2; TOML
+    is written by Click, with the values that are not mappings before the
+    tables.
+
+    :param data: The configuration to write.
+    :param path: The file to write.
+    :raise ConfigError: The suffix is not supported, or ``data`` holds a
+        value that cannot be written.
+
+    .. versionadded:: 8.6
+    """
+    name = str(path)
+    kind = _config_format(path)
+
+    try:
+        writable = _writable(data, "")
+    except ConfigError as e:
+        raise ConfigError(e.message, name) from None
+
+    if kind == "json":
+        import json
+
+        text = json.dumps(writable, indent=2, ensure_ascii=False) + "\n"
+    else:
+        lines = _toml_table(writable, [])
+        text = "".join(f"{line}\n" for line in lines)
+
+    try:
+        with open(path, "w", encoding="utf-8") as f:
+            f.write(text)
+    except OSError as e:
+        raise ConfigError(
+            _("cannot write the file: {reason}").format(reason=e.strerror or e), name
+        ) from e
